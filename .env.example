# Copy to .env and adjust. The backend/worker read these via pydantic-settings
# (env prefixes: DATABASE_, MINIO_, OLLAMA_, INGESTION_, EMBEDDING_, ...).

# PostgreSQL (pgvector)
POSTGRES_PASSWORD=hr
# Host port for postgres (default 5433). Set 5434 here because 5433 is
# already taken on this machine by an orphaned listener (root-owned).
POSTGRES_HOST_PORT=5434

# MinIO (S3-compatible object storage)
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
# Host ports for the MinIO S3 API + console (defaults 9100/9101 are occupied
# on this machine by a root-owned orphaned minio process, so use 9200/9201).
MINIO_API_PORT=9200
MINIO_CONSOLE_PORT=9201

# Backend / frontend host ports (defaults 8000 / 3000 are free on this host).
# BACKEND_HOST_PORT=8000
# FRONTEND_HOST_PORT=3000

# Embedding model (Ollama). The compose backend/worker reuse an Ollama that is
# already running on the host (via host.docker.internal:11434). For a fully
# containerized setup instead: docker compose --profile local-models up -d
# OLLAMA_URL=http://localhost:11434

# CORS origins allowed to call the API from the browser (the Next.js UI on
# :3000). Comma-separated; "*" allows any origin (fine locally, no cookies).
# CORS_ALLOW_ORIGINS=*

# Cross-encoder reranker (RERANKER_*). Enabled in docker-compose.yml; the
# backend image installs the optional `reranker` extra (sentence-transformers,
# ~2.5 GB with torch) and downloads BAAI/bge-reranker-base from HuggingFace on
# first search (cached in ~/.cache/huggingface, mounted into the container).
# RERANKER_ENABLED=true
# RERANKER_MODEL=BAAI/bge-reranker-base
