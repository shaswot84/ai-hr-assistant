# ── App ─────────────────────────────────────────────────────────────
APP_ENV=development
DEBUG=true

# ── Auth provider (jwt — the only supported provider) ──────────────
AUTH_PROVIDER=jwt

# Self-issued JWT auth (no external IdP). Use a long random string.
JWT_SECRET_KEY=change-me-to-a-long-random-secret

# OK. Rarely need to set these (see config/settings.py):
# JWT_ALGORITHM=HS256
# JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60
# JWT_ISSUER=ai-hr-assistant

# ── Database ────────────────────────────────────────────────────────
DATABASE_URL=postgresql+psycopg2://hr:hr-dev-password@postgres:5432/hr

# Optional: postgres+pgvector URL for repository integration tests
# TEST_DATABASE_URL=postgresql+asyncpg://hr:hr@localhost:55432/test_hr

# ── MinIO (object store) ────────────────────────────────────────────
MINIO_ENDPOINT=minio:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_SECURE=false
MINIO_BUCKET=hr-assets

# ── Email (Mailpit in dev) ──────────────────────────────────────────
SMTP_HOST=mailpit
SMTP_PORT=1025
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_ADDR=AI HR Assistant <no-reply@hr.local>

# ── Knowledge / retrieval ───────────────────────────────────────────
# EMBEDDING_MODEL=nomic-embed-text
# EMBEDDING_DIMENSION=768
# RETRIEVAL_TOP_K=20
# RETRIEVAL_RERANK_TOP_N=5
# RETRIEVAL_CONFIDENCE_THRESHOLD=0.5
# RERANKER_MODEL=BAAI/bge-reranker-base
# RERANKER_ENABLED=true

# ── Embeddings (Ollama local model runner) ──────────────────────────
OLLAMA_URL=http://localhost:11434

# ── AI scoring: hosted Ollama chat API ──────────────────────────────
OLLAMA_CHAT_API_BASE=https://ollama.com
OLLAMA_CHAT_API_KEY=
OLLAMA_CHAT_MODEL=gpt-oss:120b-cloud