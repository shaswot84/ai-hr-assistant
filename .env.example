# ── App ─────────────────────────────────────────────────────────────
APP_ENV=development
DEBUG=true

# Which auth provider to use: dev_stub | keycloak
AUTH_PROVIDER=dev_stub

# Secret for signing dev-session cookies
SECRET_KEY=dev-secret-change-me

# ── Database ────────────────────────────────────────────────────────
DATABASE_URL=postgresql+psycopg2://hr:hr-dev-password@postgres:5432/hr

# ── MinIO (object store) ────────────────────────────────────────────
MINIO_ENDPOINT=minio:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_SECURE=false
MINIO_BUCKET=hr-assets

# ── Email (Mailpit in dev) ──────────────────────────────────────────
SMTP_HOST=mailpit
SMTP_PORT=1025
SMTP_USER=
SMTP_PASSWORD=

# ── AI scoring: hosted Ollama API ───────────────────────────────────
OLLAMA_API_BASE=https://ollama.com
OLLAMA_API_KEY=
OLLAMA_MODEL=gpt-oss:120b-cloud

# ── Keycloak (only when AUTH_PROVIDER=keycloak) ─────────────────────
KEYCLOAK_URL=http://localhost:8080
KEYCLOAK_REALM=hr-assistant
KEYCLOAK_CLIENT_ID=hr-portal
KEYCLOAK_CLIENT_SECRET=change-me
KEYCLOAK_REDIRECT_URI=http://localhost:3000/auth/callback
