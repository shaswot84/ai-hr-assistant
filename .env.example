# Copy to .env and adjust. The backend/worker read these via pydantic-settings
# (env prefixes: DATABASE_, MINIO_, OLLAMA_, INGESTION_, EMBEDDING_, JWT_, SMTP_, ...).

# ── App ─────────────────────────────────────────────────────────────
APP_ENV=development
DEBUG=true

# ── Database ────────────────────────────────────────────────────────
# asyncpg driver: used directly by the Knowledge Service's async engine and
# by Alembic. The sync recruitment/auth engine (db/sync_session.py) derives
# its own +psycopg2 URL from this one — no second env var needed.
DATABASE_URL=postgresql+asyncpg://hr:hr@postgres:5432/hr_assistant
POSTGRES_PASSWORD=hr
# Host port for postgres (container-internal port is always 5432).
POSTGRES_HOST_PORT=5433

# ── Auth provider (jwt — the only supported provider) ──────────────
AUTH_PROVIDER=jwt

# Self-issued JWT auth (no external IdP). Use a long random string.
JWT_SECRET_KEY=change-me-to-a-long-random-secret

# OK. Rarely need to set these (see config/settings.py):
# JWT_ALGORITHM=HS256
# JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60
# JWT_ISSUER=ai-hr-assistant

# ── MinIO (S3-compatible object storage) ────────────────────────────
# MINIO_ROOT_USER/PASSWORD configure the minio server container itself;
# the app-level MINIO_ACCESS_KEY/SECRET_KEY (bridged in docker-compose.yml)
# are what the backend/worker actually authenticate with.
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
MINIO_API_PORT=9100
MINIO_CONSOLE_PORT=9101
MINIO_BUCKET=hr-documents

# ── Email (Mailpit in dev) ──────────────────────────────────────────
SMTP_HOST=mailpit
SMTP_PORT=1025
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_ADDR=AI HR Assistant <no-reply@hr.local>

# ── Backend / frontend host ports (defaults 8000 / 3000 are free on this host) ──
# BACKEND_HOST_PORT=8000
# FRONTEND_HOST_PORT=3000

# ── CORS ─────────────────────────────────────────────────────────────
# Origins allowed to call the API from the browser (the Next.js UI on :3000).
# Comma-separated; "*" allows any origin (fine locally, no cookies).
# CORS_ALLOW_ORIGINS=*

# ── Generation LLM (Ollama Cloud) ────────────────────────────────────
# Turns retrieved chunks into a polished answer in the portal chatbots.
# Requires an Ollama Cloud account + API key (https://ollama.com/settings/keys).
# Keep LLM_API_KEY out of version control; put your real key in .env only.
LLM_ENABLED=false
LLM_URL=https://ollama.com
LLM_API_KEY=
LLM_MODEL=gpt-oss:120b-cloud

# ── Knowledge / retrieval ───────────────────────────────────────────
# EMBEDDING_MODEL=nomic-embed-text
# EMBEDDING_DIMENSION=768
# RETRIEVAL_TOP_K=30
# RETRIEVAL_RERANK_TOP_N=5
# RETRIEVAL_CONFIDENCE_THRESHOLD=0.55
# RERANKER_MODEL=BAAI/bge-reranker-base
# RERANKER_ENABLED=true

# ── Embeddings (Ollama local model runner) ──────────────────────────
# The compose backend/worker reuse an Ollama already running on the host (via
# host.docker.internal:11434). For a fully containerized setup instead:
# docker compose --profile local-models up -d
# OLLAMA_URL=http://localhost:11434

# ── AI scoring: hosted Ollama chat API (recruitment resume screening) ──
OLLAMA_CHAT_API_BASE=https://ollama.com
OLLAMA_CHAT_API_KEY=
OLLAMA_CHAT_MODEL=gpt-oss:120b-cloud

# ── Ingestion pipeline ───────────────────────────────────────────────
# INGESTION_POLL_INTERVAL_SECONDS=5
